{
  "name": "mahjong-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic core for Thompson & Maloney Chinese/Australian mahjong.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "soak": "SOAK_SEEDS=300 node --test test/soak.test.ts",
    "test:watch": "node --test --watch test/*.test.ts",
    "check": "node bin/check.ts",
    "replay": "node bin/replay.ts",
    "play": "node bin/play.ts",
    "serve": "node bin/serve.ts"
  }
}
