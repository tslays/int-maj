{
  "name": "int-maj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic core for international mahjong (Thompson & Maloney).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "soak": "SOAK_SEEDS=300 node --test test/soak.test.ts",
    "test:watch": "node --test --watch test/*.test.ts",
    "test:layout": "node tools/check-layout.ts",
    "check": "node bin/check.ts",
    "replay": "node bin/replay.ts",
    "play": "node bin/play.ts",
    "serve": "node --watch bin/serve.ts",
    "build": "node --disable-warning=ExperimentalWarning tools/build-web.ts",
    "preview": "node bin/preview.ts",
    "deploy": "npm test && npm run build && npx --yes wrangler@4.158.0 deploy"
  }
}
