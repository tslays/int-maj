// Cloudflare deployment of the offline app. The site is the static `dist/`
// folder from `npm run build`, served as assets; the Worker in front of it
// (`src/worker/`) answers `/api/*`, which is where "Report a problem" posts,
// and writes each site's home-screen name (APP_SHORT_NAME) into the page and
// manifest. Only `dist/` and the bundled Worker are uploaded, never the
// repository.
//   int      the tester site, deployed on a tag v* (`npm run deploy`)
//   int-dev  the development site: every green push to main, and the
//            pull-request previews (`wrangler deploy --env dev`)
// The secret REPORT_GITHUB_TOKEN (a GitHub token that may write issues in
// REPORT_REPO) is set by the deploy action from the repository secret of the
// same name; without it a report falls back to the phone's share sheet.
{
  "name": "int",
  // Not a secret: it names the account; the API token is the secret.
  "account_id": "8dff3ba1767be52478763587743e143b",
  "compatibility_date": "2026-11-04",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/manifest.webmanifest"]
  },
  "vars": {
    "REPORT_REPO": "tslays/int-maj",
    // The name the home screen gives the app (src/worker/short-name.ts).
    "APP_SHORT_NAME": "int-maj"
  },
  // Five reports a minute from one address.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Ten new rooms a minute from one address.
    { "name": "ROOM_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  // A report's optional photos (up to three), kept private (no public access on the bucket).
  "r2_buckets": [{ "binding": "REPORT_PHOTOS", "bucket_name": "int-maj" }],
  // Online rooms (docs/MULTIPLAYER.md): the Durable Object lives in its own
  // Worker (wrangler.rooms.jsonc), deployed first; binding to it keeps this
  // Worker's pull-request preview links, which Cloudflare does not give a
  // Worker that implements a Durable Object.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomObject", "script_name": "int-rooms" }] },
  "env": {
    "dev": {
      "name": "int-dev",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/", "/index.html", "/manifest.webmanifest"]
      },
      "vars": {
        "REPORT_REPO": "tslays/int-maj",
        "APP_SHORT_NAME": "int-dev"
      },
      "ratelimits": [
        { "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
        { "name": "ROOM_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
      ],
      "r2_buckets": [{ "binding": "REPORT_PHOTOS", "bucket_name": "int-maj" }],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomObject", "script_name": "int-rooms-dev" }] }
    }
  }
}
