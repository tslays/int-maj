// Cloudflare deployment of the offline app. The site is the static `dist/`
// folder from `npm run build`, served as assets; the Worker in front of it
// (`src/worker/`) answers only `/api/*`, which is where "Report a problem"
// posts. Only `dist/` and the bundled Worker are uploaded, never the
// repository.
//   int      the tester site, deployed on a tag v* (`npm run deploy`)
//   int-dev  the development site: every green push to main, and the
//            pull-request previews (`wrangler deploy --env dev`)
// The secret REPORT_GITHUB_TOKEN (a GitHub token that may write issues in
// REPORT_REPO) is set by the deploy action from the repository secret of the
// same name; without it a report falls back to the phone's share sheet.
{
  "name": "int",
  // Not a secret: it names the account; the API token is the secret.
  "account_id": "8dff3ba1767be52478763587743e143b",
  "compatibility_date": "2026-11-04",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "REPORT_REPO": "tslays/int-maj"
  },
  // Five reports a minute from one address.
  "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "env": {
    "dev": {
      "name": "int-dev",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "REPORT_REPO": "tslays/int-maj"
      },
      "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }]
    }
  }
}
