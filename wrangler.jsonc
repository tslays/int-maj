// Cloudflare deployment of the offline app: `npm run deploy`.
// The site is the static `dist/` folder from `npm run build`; there is no
// server code. Only `dist/` is uploaded, never the repository.
{
  "name": "int-maj",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  }
}
