// Cloudflare deployment of the offline app. The site is the static `dist/`
// folder from `npm run build`; there is no server code. Only `dist/` is
// uploaded, never the repository.
//   int      the tester site, deployed on a tag v* (`npm run deploy`)
//   int-dev  the development site: every green push to main, and the
//            pull-request previews (`wrangler deploy --env dev`)
{
  "name": "int",
  // Not a secret: it names the account; the API token is the secret.
  "account_id": "8dff3ba1767be52478763587743e143b",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  },
  "env": {
    "dev": {
      "name": "int-dev",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist"
      }
    }
  }
}
